<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplikacjaMobilna.Pages.LoadingPage"
             BackgroundColor="#F1F5F9"
             Title="Ładowanie"
             Shell.NavBarIsVisible="False">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
        <Border BackgroundColor="White" 
                Stroke="#E2E8F0" 
                StrokeThickness="1" 
                Padding="36,32" 
                StrokeShape="RoundRectangle 24"
                WidthRequest="300">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,8" Radius="20" Opacity="0.08" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18" HorizontalOptions="Center">
                <!-- Logo aplikacji -->
                <Border BackgroundColor="#CCFBF1" 
                        WidthRequest="72" 
                        HeightRequest="72" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 36" 
                        HorizontalOptions="Center">
                    <Label Text="🛡️" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Nazwa i podtytuł -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Aplikacja Seniora" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0F172A" 
                           HorizontalTextAlignment="Center" />
                    <Label Text="Bezpieczeństwo i opieka" 
                           FontSize="13" 
                           TextColor="#64748B" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Wskaźnik ładowania -->
                <ActivityIndicator IsRunning="True" 
                                   IsVisible="True" 
                                   Color="#0F766E" 
                                   WidthRequest="44" 
                                   HeightRequest="44" 
                                   Margin="0,6,0,0" />

                <Label Text="Przygotowywanie aplikacji..." 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="#0F766E" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>