<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplikacjaMobilna.PageModels"
             x:Class="AplikacjaMobilna.Pages.MainPage"
             x:DataType="vm:MainPageViewModel"
             BackgroundColor="#F4F6F9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Górny pasek statusu (Pasek opiekuna i baterii) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" BackgroundColor="#2E7D32" Padding="15,10">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <Label Text="🛡️" FontSize="18" VerticalOptions="Center" />
                <Label Text="OPIEKUN CZUWA" FontAttributes="Bold" TextColor="White" FontSize="16" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                <Label Text="🔋" FontSize="18" VerticalOptions="Center" />
                <Label Text="{Binding BatteryLevel, StringFormat='{0}%'}" FontAttributes="Bold" TextColor="White" FontSize="16" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Główna zawartość -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- Główny czerwony przycisk SOS -->
                <Border Stroke="#D32F2F" 
                        StrokeThickness="3"
                        Background="#FFEBEE" 
                        HeightRequest="220" 
                        WidthRequest="220"
                        HorizontalOptions="Center" 
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="110" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TriggerSosCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="WEZWIJ" TextColor="#D32F2F" FontAttributes="Bold" FontSize="26" HorizontalTextAlignment="Center" />
                        <Label Text="POMOC!" TextColor="#D32F2F" FontAttributes="Bold" FontSize="28" HorizontalTextAlignment="Center" />
                        <Label Text="SOS - Przytrzymaj&#10;3 sekundy" TextColor="#B71C1C" FontSize="11" HorizontalTextAlignment="Center" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Sekcja: Moje Narzędzia -->
                <Label Text="MOJE NARZĘDZIA" FontAttributes="Bold" FontSize="20" TextColor="#1A1A1A" HorizontalTextAlignment="Center" Margin="0,10,0,0" />

                <!-- Siatka z kafelkami narzędzi -->
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="15" RowSpacing="15">

                    <!-- Kafelek: Kompas do domu -->
                    <Border Grid.Row="0" Grid.Column="0" 
                            Stroke="#CCCCCC" 
                            StrokeThickness="1"
                            Background="White"
                            StrokeShape="RoundRectangle 15"
                            Padding="15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCompassCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🧭" FontSize="36" HorizontalTextAlignment="Center" />
                            <Label Text="KOMPAS DO DOMU" FontAttributes="Bold" FontSize="13" TextColor="#333333" HorizontalTextAlignment="Center" />
                            <Label Text="🏠" FontSize="28" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Kafelek: Mój Spacer -->
                    <Border Grid.Row="0" Grid.Column="1" 
                            Stroke="#CCCCCC" 
                            StrokeThickness="1"
                            Background="White"
                            StrokeShape="RoundRectangle 15"
                            Padding="15">
                        <!-- DODANE: Obsługa kliknięcia -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWalkCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="🚶" FontSize="28" HorizontalTextAlignment="Center" />
                            <Label Text="MÓJ SPACER" FontAttributes="Bold" FontSize="13" TextColor="#333333" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding WalkDistance}" FontAttributes="Bold" FontSize="22" TextColor="#2E7D32" HorizontalTextAlignment="Center" />
                            <Label Text="Dystans dzisiaj" FontSize="10" TextColor="#666666" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Border>

                    <!-- Kafelek szeroki: Kontakt z opiekunem -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                            Stroke="#CCCCCC" 
                            StrokeThickness="1"
                            Background="White"
                            StrokeShape="RoundRectangle 15"
                            Padding="15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallCaregiverCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="📞" FontSize="32" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="KONTAKT Z OPIEKUNEM" FontAttributes="Bold" FontSize="16" TextColor="#333333" />
                                <Label Text="ZADZWOŃ TERAZ" FontAttributes="Bold" FontSize="14" TextColor="#1976D2" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Dolny pasek nawigacyjny -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" BackgroundColor="#E0E0E0" Padding="10">
            <Button Grid.Column="0" Text="START" FontAttributes="Bold" FontSize="18" TextColor="Black" BackgroundColor="Transparent" />
            <Button Grid.Column="1" Text="MENU" FontAttributes="Bold" FontSize="18" TextColor="Black" BackgroundColor="Transparent" />
        </Grid>

    </Grid>

</ContentPage>