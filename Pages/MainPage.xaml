<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplikacjaMobilna.PageModels"
             x:Class="AplikacjaMobilna.Pages.MainPage"
             x:DataType="vm:MainPageViewModel"
             BackgroundColor="{DynamicResource AppBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Górny pasek statusu -->
        <Border Grid.Row="0" BackgroundColor="#0F766E" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" MaximumWidthRequest="520" HorizontalOptions="Fill">

                <!-- Lewa strona: Ikona + Tekst -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Border Grid.Column="0" BackgroundColor="#14B8A6" WidthRequest="34" HeightRequest="34" StrokeThickness="0" StrokeShape="RoundRectangle 17" VerticalOptions="Center">
                        <Label Text="🛡️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="OPIEKUN CZUWA" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               FontSize="{DynamicResource FontBody}" 
                               LineBreakMode="WordWrap" />
                        <Label Text="Połączenie aktywne" 
                               TextColor="#CCFBF1" 
                               FontSize="{DynamicResource FontSmall}" 
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Prawa strona: Bateria i godzina -->
                <Border Grid.Column="1" BackgroundColor="#115E59" Padding="10,6" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding BatteryLevel, StringFormat='🔋 {0}%'}" TextColor="White" FontSize="{DynamicResource FontSmall}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="|" TextColor="#5EEAD4" FontSize="{DynamicResource FontSmall}" VerticalOptions="Center" />
                        <Label Text="{Binding CurrentTime}" TextColor="White" FontSize="{DynamicResource FontSmall}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Główna zawartość -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="20" MaximumWidthRequest="500" HorizontalOptions="Fill">

                <!-- Przycisk SOS -->
                <Border Stroke="#FCA5A5" 
                        StrokeThickness="6"
                        BackgroundColor="#DC2626" 
                        HeightRequest="200" 
                        WidthRequest="200"
                        Margin="0,6,0,0"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#DC2626" Offset="0,8" Radius="20" Opacity="0.35" />
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TriggerSosCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                        <Label Text="SOS" TextColor="White" FontAttributes="Bold" FontSize="{DynamicResource FontHero}" HorizontalTextAlignment="Center" />
                        <Label Text="WEZWIJ POMOC" TextColor="#FEE2E2" FontAttributes="Bold" FontSize="{DynamicResource FontBody}" HorizontalTextAlignment="Center" />
                        <Label Text="Dotknij w razie zagrożenia" TextColor="#FECACA" FontSize="11" HorizontalTextAlignment="Center" Margin="0,2,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Nagłówek sekcji -->
                <Label Text="MOJE NARZĘDZIA" 
                       FontAttributes="Bold" 
                       FontSize="{DynamicResource FontBody}" 
                       CharacterSpacing="1.2" 
                       TextColor="{DynamicResource SecondaryTextColor}" 
                       HorizontalTextAlignment="Center" />

                <!-- Kafelki narzędzi -->
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="14" RowSpacing="14">

                    <!-- Kompas do domu -->
                    <Border Grid.Row="0" Grid.Column="0" 
                            Stroke="{DynamicResource CardBorderColor}" 
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            StrokeShape="RoundRectangle 20"
                            Padding="18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCompassCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border BackgroundColor="#EFF6FF" WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 28" HorizontalOptions="Center">
                                <Label Text="🧭" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="KOMPAS&#10;DO DOMU" 
                                   FontAttributes="Bold" 
                                   FontSize="{DynamicResource FontBody}" 
                                   TextColor="{DynamicResource PrimaryTextColor}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Mój Spacer -->
                    <Border Grid.Row="0" Grid.Column="1" 
                            Stroke="{DynamicResource CardBorderColor}" 
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            StrokeShape="RoundRectangle 20"
                            Padding="18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWalkCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border BackgroundColor="#F0FDF4" WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 28" HorizontalOptions="Center">
                                <Label Text="🚶" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="MÓJ SPACER" 
                                   FontAttributes="Bold" 
                                   FontSize="{DynamicResource FontBody}" 
                                   TextColor="{DynamicResource PrimaryTextColor}" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding WalkDistance}" 
                                   FontAttributes="Bold" 
                                   FontSize="{DynamicResource FontMedium}" 
                                   TextColor="{DynamicResource AccentColor}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Kontakt z opiekunem -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                            Stroke="{DynamicResource CaregiverCardBorder}" 
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource CaregiverCardBg}"
                            StrokeShape="RoundRectangle 20"
                            Padding="18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallCaregiverCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border BackgroundColor="#2563EB" WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26">
                                <Label Text="📞" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="KONTAKT Z OPIEKUNEM" 
                                       FontAttributes="Bold" 
                                       FontSize="{DynamicResource FontBody}" 
                                       TextColor="{DynamicResource CaregiverTitleColor}" />
                                <Label Text="Dotknij, aby zadzwonić teraz" 
                                       FontSize="{DynamicResource FontSmall}" 
                                       TextColor="{DynamicResource CaregiverSubColor}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Dolny pasek nawigacyjny -->
        <Border Grid.Row="2" 
                BackgroundColor="{DynamicResource CardBackgroundColor}" 
                Stroke="{DynamicResource CardBorderColor}" 
                StrokeThickness="1" 
                Padding="16,10">
            <Button Text="☰ MENU I USTAWIENIA" 
                    Command="{Binding OpenMenuCommand}"
                    FontAttributes="Bold" 
                    FontSize="{DynamicResource FontMedium}" 
                    TextColor="{DynamicResource AccentColor}" 
                    BackgroundColor="Transparent"
                    MaximumWidthRequest="500"
                    HorizontalOptions="Fill" />
        </Border>

    </Grid>
</ContentPage>