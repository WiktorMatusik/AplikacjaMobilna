<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplikacjaMobilna.PageModels"
             x:Class="AplikacjaMobilna.Pages.CompassPage"
             x:DataType="vm:CompassPageViewModel"
             BackgroundColor="{DynamicResource AppBackgroundColor}"
             Title="Kompas do domu">

    <!-- Podpięcie strzałki cofania w lewym górnym rogu -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>

    <Grid>
        <!-- GŁÓWNY WIDOK KOMPASU -->
        <Grid RowDefinitions="Auto, *, Auto" Padding="20" MaximumWidthRequest="480" HorizontalOptions="Fill">

            <!-- Nagłówek -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,5,0,10">
                <Label Text="Kompas nawigacyjny" FontSize="{DynamicResource FontLarge}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                <Border BackgroundColor="{DynamicResource CardBackgroundColor}" Padding="12,6" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                    <Label Text="{Binding StatusText}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Tarcza kompasu -->
            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="24">
                <Border WidthRequest="240" 
                        HeightRequest="240" 
                        BackgroundColor="white" 
                        Stroke="#CBD5E1"
                        StrokeThickness="4"
                        HorizontalOptions="Center" 
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#0F172A" Offset="0,8" Radius="20" Opacity="0.1" />
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="120" />
                    </Border.StrokeShape>

                    <Grid Padding="14">
                        <Label Text="N" FontSize="14" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Start" />
                        <Label Text="S" FontSize="14" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="End" />
                        <Label Text="W" FontSize="14" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="Start" VerticalOptions="Center" />
                        <Label Text="E" FontSize="14" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="End" VerticalOptions="Center" />

                        <Grid Rotation="{Binding ArrowRotation}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="140" HeightRequest="140">
                            <Polygon Points="70,10 92,70 70,58 48,70" Fill="#DC2626" />
                            <Polygon Points="70,130 92,70 70,82 48,70" Fill="#94A3B8" />
                            <Ellipse WidthRequest="16" HeightRequest="16" Fill="#0F172A" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="#E2E8F0" StrokeThickness="1" Padding="24,14" StrokeShape="RoundRectangle 16">
                    <Label Text="{Binding DistanceText}" FontSize="{DynamicResource FontMedium}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Przyciski sterujące -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="🏠 DODAJ DOM" 
                        Clicked="OnAddHomeClicked"
                        BackgroundColor="#0F766E" TextColor="White" FontAttributes="Bold" FontSize="15" 
                        CornerRadius="14" HeightRequest="54" />

                <Button Grid.Column="1"
                        Text="🔄 ZMIEŃ TRYB" 
                        Command="{Binding ToggleModeCommand}"
                        BackgroundColor="#E2E8F0" TextColor="#1E293B" FontAttributes="Bold" FontSize="15" 
                        CornerRadius="14" HeightRequest="54" />
            </Grid>
        </Grid>

        <!-- WYSKAKUJĄCE OKNO Z MAPĄ, WYSZUKIWARKĄ ADRESU I OBECNĄ POZYCJĄ -->
        <Grid x:Name="MapOverlay" 
              IsVisible="False" 
              BackgroundColor="#B30F172A" 
              Padding="16">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="16" MaximumWidthRequest="520" HorizontalOptions="Fill">
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="10">

                    <!-- Tytuł -->
                    <VerticalStackLayout Grid.Row="0" Spacing="2">
                        <Label Text="Ustaw lokalizację domu" FontSize="19" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                        <Label Text="Wpisz adres, użyj GPS lub dotknij mapę" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Pasek wyszukiwania tekstowego -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="10,2">
                            <Entry x:Name="AddressSearchEntry" 
                                   Placeholder="Np. Warszawa, Marszałkowska 1" 
                                   TextColor="#0F172A"
                                   PlaceholderColor="#94A3B8"
                                   ReturnType="Search"
                                   Completed="OnSearchAddressClicked"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>

                        <Button Grid.Column="1" 
                                Text="🔍 Szukaj" 
                                Clicked="OnSearchAddressClicked"
                                BackgroundColor="#0F766E" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                Padding="14,0"
                                HeightRequest="46" />
                    </Grid>

                    <!-- Przycisk szybkiego ustawienia obecnej lokalizacji GPS -->
                    <Button Grid.Row="2"
                            x:Name="UseCurrentLocationBtn"
                            Text="📍 Ustaw obecną pozycję jako DOM"
                            Clicked="OnUseCurrentLocationClicked"
                            BackgroundColor="#E0F2FE"
                            TextColor="#0369A1"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="46" />

                    <!-- Mapa -->
                    <Border Grid.Row="3" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                        <WebView x:Name="HomeMapWebView" Navigating="OnMapNavigating" />
                    </Border>

                    <!-- Przycisk zamknięcia -->
                    <Button Grid.Row="4" 
                            Text="ANULUJ / ZAMKNIJ" 
                            Clicked="OnCloseMapClicked"
                            BackgroundColor="#EF4444" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            HeightRequest="50" 
                            CornerRadius="14" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>