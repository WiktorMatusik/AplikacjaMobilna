<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplikacjaMobilna.PageModels"
             x:Class="AplikacjaMobilna.Pages.WalkPage"
             x:DataType="vm:WalkPageViewModel"
             BackgroundColor="{DynamicResource AppBackgroundColor}"
             Title="Mój Spacer">

    <!-- Podpięcie strzałki cofania w lewym górnym rogu -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" MaximumWidthRequest="480" HorizontalOptions="Fill">

        <!-- Nagłówek -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,5,0,10">
            <Label Text="Monitorowanie Spaceru" FontSize="{DynamicResource FontLarge}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
            <Border BackgroundColor="#DCFCE7" Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                <Label Text="{Binding StatusText}" FontSize="14" FontAttributes="Bold" TextColor="#166534" HorizontalTextAlignment="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- Statystyki spaceru -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16">

            <!-- Karta dystansu -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="#E2E8F0" StrokeThickness="1" Padding="24" StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource PrimaryTextColor}" Offset="0,4" Radius="12" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="PRZEBYTY DYSTANS" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding DistanceText}" FontSize="{DynamicResource FontHero}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Karta czasu -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="#E2E8F0" StrokeThickness="1" Padding="24" StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,4" Radius="12" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="CZAS TRWANIA" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding TimeText}" FontSize="{DynamicResource FontTitle}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- Przycisk sterujący -->
        <Button Grid.Row="2"
                Text="▶ ROZPOCZNIJ / WSTRZYMAJ SPACER" 
                Command="{Binding ToggleWalkCommand}"
                BackgroundColor="#0F766E" TextColor="White" FontAttributes="Bold" FontSize="15" 
                CornerRadius="14" HeightRequest="56" />

    </Grid>
</ContentPage>