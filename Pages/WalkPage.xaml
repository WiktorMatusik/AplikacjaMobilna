<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplikacjaMobilna.PageModels"
             x:Class="AplikacjaMobilna.Pages.WalkPage"
             x:DataType="vm:WalkPageViewModel"
             BackgroundColor="{DynamicResource AppBackgroundColor}"
             Title="Mój Spacer">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12" MaximumWidthRequest="520" HorizontalOptions="Fill">

        <!-- Przełącznik zakładek: Mapa vs Statystyki -->
        <Border Grid.Row="0" 
                BackgroundColor="{DynamicResource CardBackgroundColor}" 
                Stroke="{DynamicResource CardBorderColor}" 
                StrokeThickness="1" 
                Padding="4" 
                StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
                <Button Grid.Column="0"
                        Text="🗺️ Mapa trasy"
                        Command="{Binding ShowMapTabCommand}"
                        BackgroundColor="{Binding MapTabBgColor}"
                        TextColor="{Binding MapTabTextColor}"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="46" />

                <Button Grid.Column="1"
                        Text="📊 Statystyki"
                        Command="{Binding ShowStatsTabCommand}"
                        BackgroundColor="{Binding StatsTabBgColor}"
                        TextColor="{Binding StatsTabTextColor}"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="46" />
            </Grid>
        </Border>

        <!-- ZAKŁADKA 1: MAPA I REJESTRACJA SPACERU -->
        <Grid Grid.Row="1" 
              IsVisible="{Binding IsMapTabVisible}" 
              RowDefinitions="Auto, *, Auto, Auto" 
              RowSpacing="12">

            <Border Grid.Row="0" BackgroundColor="#DCFCE7" Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                <Label Text="{Binding StatusText}" FontSize="14" FontAttributes="Bold" TextColor="#166534" HorizontalTextAlignment="Center" />
            </Border>

            <Border Grid.Row="1" 
                    Stroke="{DynamicResource CardBorderColor}" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20">
                <WebView x:Name="WalkMapWebView" />
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="{DynamicResource CardBorderColor}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="DYSTANS" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding DistanceText}" FontSize="{DynamicResource FontLarge}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="{DynamicResource CardBorderColor}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="CZAS TRWANIA" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TimeText}" FontSize="{DynamicResource FontLarge}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{Binding ActionButtonText}" 
                        Command="{Binding ToggleWalkCommand}"
                        BackgroundColor="#0F766E" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="15" 
                        CornerRadius="14" 
                        HeightRequest="56" />

                <Button Grid.Column="1"
                        Text="🏁 Zakończ" 
                        Command="{Binding ResetWalkCommand}"
                        BackgroundColor="#E2E8F0" 
                        TextColor="#1E293B" 
                        FontAttributes="Bold" 
                        FontSize="14" 
                        Padding="16,0"
                        CornerRadius="14" 
                        HeightRequest="56" />
            </Grid>
        </Grid>

        <!-- ZAKŁADKA 2: PANEL STATYSTYK (DZIEŃ / TYDZIEŃ / MIESIĄC / ROK) -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsStatsTabVisible}">
            <VerticalStackLayout Spacing="16" Padding="0,6,0,10">

                <!-- Wybór okresu czasu -->
                <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                        Stroke="{DynamicResource CardBorderColor}" 
                        StrokeThickness="1" 
                        Padding="14" 
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Wybierz okres podsumowania:" 
                               FontSize="{DynamicResource FontBody}" 
                               FontAttributes="Bold" 
                               TextColor="{DynamicResource PrimaryTextColor}" 
                               HorizontalTextAlignment="Center" />

                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    Text="Dzień"
                                    Command="{Binding SelectPeriodCommand}"
                                    CommandParameter="Dzień"
                                    BackgroundColor="{Binding DayBtnBg}"
                                    TextColor="{Binding DayBtnText}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="2,0"
                                    CornerRadius="10"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="Tydzień"
                                    Command="{Binding SelectPeriodCommand}"
                                    CommandParameter="Tydzień"
                                    BackgroundColor="{Binding WeekBtnBg}"
                                    TextColor="{Binding WeekBtnText}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="2,0"
                                    CornerRadius="10"
                                    HeightRequest="44" />

                            <Button Grid.Column="2"
                                    Text="Miesiąc"
                                    Command="{Binding SelectPeriodCommand}"
                                    CommandParameter="Miesiąc"
                                    BackgroundColor="{Binding MonthBtnBg}"
                                    TextColor="{Binding MonthBtnText}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="2,0"
                                    CornerRadius="10"
                                    HeightRequest="44" />

                            <Button Grid.Column="3"
                                    Text="Rok"
                                    Command="{Binding SelectPeriodCommand}"
                                    CommandParameter="Rok"
                                    BackgroundColor="{Binding YearBtnBg}"
                                    TextColor="{Binding YearBtnText}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="2,0"
                                    CornerRadius="10"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Główna karta z wynikiem (Dystans + Czas) dla wybranego okresu -->
                <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                        Stroke="{DynamicResource CardBorderColor}" 
                        StrokeThickness="1" 
                        Padding="22" 
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">
                        <Label Text="{Binding SelectedPeriodTitle}" 
                               FontSize="{DynamicResource FontMedium}" 
                               FontAttributes="Bold" 
                               TextColor="{DynamicResource SecondaryTextColor}" 
                               HorizontalTextAlignment="Center" />

                        <Grid ColumnDefinitions="*, 1, *" ColumnSpacing="10" Margin="0,4">
                            <!-- Kolumna Dystansu -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                                <Label Text="🚶 DYSTANS" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PeriodDistanceText}" FontSize="{DynamicResource FontLarge}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1" WidthRequest="1" Color="{DynamicResource CardBorderColor}" />

                            <!-- Kolumna Czasu -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                <Label Text="⏱️ ŁĄCZNY CZAS" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PeriodDurationText}" FontSize="{DynamicResource FontLarge}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{Binding PeriodRangeDescription}" 
                               FontSize="{DynamicResource FontSmall}" 
                               TextColor="{DynamicResource SecondaryTextColor}" 
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Szybkie zestawienie wszystkich 4 okresów naraz -->
                <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                        Stroke="{DynamicResource CardBorderColor}" 
                        StrokeThickness="1" 
                        Padding="18" 
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="ZESTAWIENIE ZBIORCZE" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               CharacterSpacing="1" 
                               TextColor="{DynamicResource SecondaryTextColor}" />

                        <!-- Dzisiaj -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Dzisiaj" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding TodayDistanceText}" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="End" />
                                <Label Text="{Binding TodayDurationText}" FontSize="{DynamicResource FontSmall}" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <!-- Ten tydzień -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Ten tydzień" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding WeekDistanceText}" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="End" />
                                <Label Text="{Binding WeekDurationText}" FontSize="{DynamicResource FontSmall}" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <!-- Ten miesiąc -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Ten miesiąc" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding MonthDistanceText}" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="End" />
                                <Label Text="{Binding MonthDurationText}" FontSize="{DynamicResource FontSmall}" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <!-- Ten rok -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Ten rok" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding YearDistanceText}" FontSize="{DynamicResource FontBody}" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="End" />
                                <Label Text="{Binding YearDurationText}" FontSize="{DynamicResource FontSmall}" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>