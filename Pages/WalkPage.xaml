<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplikacjaMobilna.PageModels"
             x:Class="AplikacjaMobilna.Pages.WalkPage"
             x:DataType="vm:WalkPageViewModel"
             BackgroundColor="#F4F6F9"
             Title="Mój Spacer">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="20">
        <Label Text="🚶" FontSize="60" HorizontalTextAlignment="Center" />
        <Label Text="Mój Spacer" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#333333" />
        <Label Text="Strona w budowie" FontSize="18" TextColor="#666666" HorizontalTextAlignment="Center" />

        <!-- Przycisk powrotu -->
        <Border Stroke="#1976D2" StrokeThickness="2" Background="#1976D2" StrokeShape="RoundRectangle 12" Padding="15,10" HorizontalOptions="Center" WidthRequest="200">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
            </Border.GestureRecognizers>
            <Label Text="POWRÓT" TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
        </Border>
    </VerticalStackLayout>

</ContentPage>